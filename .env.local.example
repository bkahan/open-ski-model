# MapTiler API key — free tier (https://www.maptiler.com/cloud/) gives 100K
# monthly map loads, no card required. Used for the 2D picker style.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional: customize the User-Agent used for Nominatim geocoding (their
# usage policy requires identifying the application).
NEXT_PUBLIC_APP_NAME="open-ski-model"
NEXT_PUBLIC_APP_CONTACT="contact@example.com"

# Optional: where the static ski dataset lives (the `data` branch built by
# .github/workflows/ski-data.yml). Defaults to jsDelivr's mirror of it.
SKI_DATA_BASE=

# No keys required for elevation data — Copernicus / SRTM are served from
# public AWS Open Data buckets, USGS 3DEP is a free government endpoint.
